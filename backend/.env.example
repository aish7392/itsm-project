# Copy to .env (docker-compose reads it) or export these variables.
DATABASE_URL=postgresql+psycopg://itsm:itsm@localhost:5432/itsm
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_MINUTES=480
SLA_MONITOR_INTERVAL=30          # seconds between background SLA checks
SLA_WARNING_THRESHOLD=0.75       # warn when 75% of the SLA window has elapsed
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Real e-mail (optional). Leave SMTP_HOST empty to simulate (emails go to the outbox table).
# Gmail example: create an App Password (Google Account → Security → App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=itsm@example.com
